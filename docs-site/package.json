{
  "name": "bazardrive-docs-site",
  "version": "0.1.0",
  "private": true,
  "description": "BazarDriveCloud documentation site (docs-as-code, Docusaurus). A separate docs layer — it does not touch the runtime PWA in public/.",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "validate:frontmatter": "node scripts/validate-frontmatter.mjs",
    "validate:registry": "node scripts/validate-document-registry.mjs",
    "validate:self": "node scripts/validate-mini-yonder-core.mjs",
    "validate:nav": "node scripts/validate-navigation.mjs",
    "inventory:repo": "node scripts/scan-repository-inventory.mjs",
    "check": "npm run validate:frontmatter && npm run validate:registry && npm run validate:self && npm run validate:nav && npm run build"
  },
  "dependencies": {
    "@docusaurus/core": "^3.6.0",
    "@docusaurus/preset-classic": "^3.6.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "browserslist": {
    "production": [">0.5%", "not dead", "not op_mini all"],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
