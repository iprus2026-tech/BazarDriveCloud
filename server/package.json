{
  "name": "@bazardrive/server",
  "version": "0.0.0",
  "private": true,
  "description": "BazarDrive self-hosted backend (Phase 1 scaffold) — per ADR BD-DOCS-041",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.js",
    "test": "node --test",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.2",
    "fastify": "^5.1.0",
    "fastify-plugin": "^6.0.0",
    "pg": "^8.13.1"
  }
}
