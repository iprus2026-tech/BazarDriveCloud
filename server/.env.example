# /server/.env.example — copy to .env for local dev (NEVER commit .env). Per ADR BD-DOCS-041.

# --- CONFIGURATION (non-secret) ---
# Staging policy: NODE_ENV=production and OTP_DEV_MODE=false.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# The exact GitHub Pages origin the client is served from — the CORS allow-list, mirror of
# the client CSP connect-src change. Required in production; leave empty in dev (CORS off).
ALLOWED_ORIGIN=
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_DEV_MODE=true
# OTP limits (BD-AUTH-HARDEN-01 #824), counted over the last hour; always on, in every profile.
# A refusal is 429 with Retry-After. Unset = the values below. Every cap is at least 1; only the
# resend pause may be 0.
# - pause before the same phone gets another code, seconds (0..3600)
OTP_RESEND_SECONDS=60
# - codes per phone per hour (1..1000)
OTP_PHONE_REQUESTS_PER_HOUR=5
# - code requests per source address per hour (1..100000). Without PUBLIC_EXPOSURE every request
#   through a local stand proxy comes from 127.0.0.1; raise this for a multi-account local session.
OTP_IP_REQUESTS_PER_HOUR=20
# - failed checks per phone per hour, across all of its codes (1..1000)
OTP_PHONE_FAILED_VERIFIES_PER_HOUR=10
SESSION_TTL_SECONDS=0
# BD-AUTH-TELEGRAM-01 (ADR BD-DOCS-052): sign-in with Telegram Mini App initData.
# The bot token goes ONLY into your local server/.env — never into git, chat, logs or reports.
# Empty = POST /api/v1/auth/telegram answers 503 TELEGRAM_DISABLED; nothing else changes.
TELEGRAM_BOT_TOKEN=
# How old an initData auth_date may be (seconds, 60..86400).
TELEGRAM_INITDATA_MAX_AGE_SECONDS=600
# A Telegram session's lifetime (seconds, 300..31536000), independent of SESSION_TTL_SECONDS.
TELEGRAM_SESSION_TTL_SECONDS=604800
# Receipt commission in percent, a plain decimal 0..100 (BD-RIDE-AUTHORITY-01B-C); unset = 12.
RECEIPT_COMMISSION_PERCENT=12
# Local stand only: approve driver applications at once (BD-AUTH-POLICY-01B-A); true|false,
# unset = false. Forbidden when NODE_ENV=production. Decide applications with `npm run ops:driver`.
DRIVER_ENROLLMENT_AUTO_APPROVE=false
# Public profile for a stand reachable from the internet, e.g. through a tunnel
# (BD-STAND-PUBLIC-01 #1124). Strictly true|false; unset = false (development unchanged).
# When true:
# - HOST defaults to 127.0.0.1 and OTP_DEV_MODE to false;
# - startup is refused on OTP_DEV_MODE=true, DRIVER_ENROLLMENT_AUTO_APPROVE=true,
#   SESSION_TTL_SECONDS=0/unset or a non-loopback HOST;
# - /auth/otp/* answers 403 OTP_DISABLED (sign-in is through Telegram);
# - X-Forwarded-For is trusted from loopback peers only.
# The 64 KiB request-body ceiling applies in every profile.
# The explicit values ABOVE are for local development and override those defaults. To enable the
# profile, change them too, or startup is refused:
#   PUBLIC_EXPOSURE=true
#   HOST=127.0.0.1                  (or ::1 / localhost; never 0.0.0.0)
#   OTP_DEV_MODE=false
#   SESSION_TTL_SECONDS=86400       (any positive value; 0 = never expires is refused)
#   DRIVER_ENROLLMENT_AUTO_APPROVE=false
PUBLIC_EXPOSURE=false

# --- SECRETS (deliver at runtime; never bake into an image or commit real values) ---
# Local-only placeholder; staging/production must inject a secret DATABASE_URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bazardrive
SESSION_SECRET=

# --- DARK in Phase 1 (structured, no consumer yet) ---
# REDIS_URL=               # Phase 2+ (#2/#3/#4, BD-DOCS-033)
# S3_ENDPOINT=             # Phase 5/6 (BD-DOCS-037)
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
